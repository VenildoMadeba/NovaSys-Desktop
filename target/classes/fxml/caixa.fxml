<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mz.novasys.controller.CaixaController" prefHeight="720.0" prefWidth="1024.0" style="-fx-background-color: #f8fafc;">
    
    <!-- CABECALHO COM DATA E HORA EM TEMPO REAL -->
    <HBox style="-fx-background-color: #0f172a; -fx-padding: 15px 25px;" alignment="CENTER_LEFT">
        <VBox>
            <Label text="NovaSys Desktop - Controle de Caixa e Tesouraria" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="lblDataHoraAtual" text="Data/Hora: --/--/---- --:--:--" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblStatusCaixa" text="CAIXA: FECHADO" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 0 20px 0 0;"/>
        <Button text="Voltar ao Painel" onAction="#aoClicarVoltar" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <HBox VBox.vgrow="ALWAYS" spacing="15" style="-fx-padding: 15px;">
        
        <!-- PAINEL ESQUERDO: Abertura, Sangria, Suprimento e Fecho -->
        <VBox prefWidth="350" spacing="15">
            <!-- Abertura de Turno -->
            <VBox fx:id="cardAbertura" spacing="10" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <Label text="Abertura do Turno" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                <Separator/>
                <VBox spacing="2">
                    <Label text="Fundo de Maneio / Troco Inicial (MT)" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtSaldoInicial" promptText="0.00" style="-fx-pref-height: 35px;"/>
                </VBox>
                <Button text="ABRIR TURNO DE CAIXA" onAction="#abrirCaixa" maxWidth="Infinity" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 40px;"/>
            </VBox>

            <!-- Sangria / Suprimento -->
            <VBox fx:id="cardOperacoes" spacing="10" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <Label text="Operacoes de Caixa" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                <Separator/>
                <VBox spacing="2">
                    <Label text="Valor da Operacao (MT)" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtValorOperacao" promptText="0.00" style="-fx-pref-height: 35px;"/>
                </VBox>
                <VBox spacing="2">
                    <Label text="Descricao / Motivo" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="txtDescricaoOperacao" promptText="Ex: Retirada para banco / Troco extra" style="-fx-pref-height: 35px;"/>
                </VBox>
                <HBox spacing="10">
                    <Button text="Suprimento (+)" onAction="#registrarSuprimento" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 35px;"/>
                    <Button text="Sangria (-)" onAction="#registrarSangria" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 35px;"/>
                </HBox>
                <Separator/>
                <Button text="FECHAR CAIXA DO DIA" onAction="#fecharCaixa" maxWidth="Infinity" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 40px;"/>
            </VBox>
            
            <Label fx:id="lblMensagem" wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
        </VBox>

        <!-- PAINEL DIREITO: Resumo por Forma de Pagamento e Tabela de Movimentos -->
        <VBox HBox.hgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <!-- Resumo Financeiro do Caixa Activo -->
            <HBox spacing="15" style="-fx-padding: 0 0 10px 0;">
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f5f9; -fx-padding: 10px; -fx-background-radius: 6px;">
                    <Label text="Dinheiro em Gaveta" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblTotalDinheiro" text="0.00 MT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f5f9; -fx-padding: 10px; -fx-background-radius: 6px;">
                    <Label text="M-Pesa / E-Mola" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblTotalMobile" text="0.00 MT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f5f9; -fx-padding: 10px; -fx-background-radius: 6px;">
                    <Label text="POS / Cartao" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblTotalPOS" text="0.00 MT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
            </HBox>

            <Label text="Extrato de Movimentacoes do Turno Activo" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TableView fx:id="tabelaMovimentos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDataHora" text="Data/Hora" prefWidth="160"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
                    <TableColumn fx:id="colDescricao" text="Descricao" prefWidth="200"/>
                    <TableColumn fx:id="colFormaPag" text="Forma Pag." prefWidth="110"/>
                    <TableColumn fx:id="colValor" text="Valor (MT)" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>