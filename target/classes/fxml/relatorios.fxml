<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mz.novasys.controller.RelatoriosController" prefHeight="720.0" prefWidth="1024.0" style="-fx-background-color: #f8fafc;">
    
    <!-- CABECALHO -->
    <HBox style="-fx-background-color: #0f172a; -fx-padding: 15px 25px;" alignment="CENTER_LEFT">
        <Label text="NovaSys Desktop - Relatorios e Analises Financeiras" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Voltar ao Painel" onAction="#aoClicarVoltar" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" spacing="15" style="-fx-padding: 15px;">
        
        <!-- BARRA DE FILTROS E KPIS -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <VBox spacing="2">
                <Label text="Data Início" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <DatePicker fx:id="dpDataInicio" style="-fx-pref-height: 35px; -fx-pref-width: 140px;"/>
            </VBox>

            <VBox spacing="2">
                <Label text="Data Fim" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <DatePicker fx:id="dpDataFim" style="-fx-pref-height: 35px; -fx-pref-width: 140px;"/>
            </VBox>

            <Button text="Filtrar Período" onAction="#filtrarRelatorio" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 35px; -fx-cursor: hand; -fx-margin: 15 0 0 0;"/>
            
            <Region HBox.hgrow="ALWAYS"/>

            <!-- CARDS DE MÉTRICAS (KPIS) -->
            <VBox style="-fx-background-color: #f1f5f9; -fx-padding: 8px 15px; -fx-background-radius: 6px;">
                <Label text="Total Faturado" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalFaturado" text="0.00 MT" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
            </VBox>

            <VBox style="-fx-background-color: #f1f5f9; -fx-padding: 8px 15px; -fx-background-radius: 6px;">
                <Label text="Total Descontos" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalDescontos" text="0.00 MT" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
            </VBox>

            <VBox style="-fx-background-color: #f1f5f9; -fx-padding: 8px 15px; -fx-background-radius: 6px;">
                <Label text="Lucro Est. Bruto" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblLucroEstimado" text="0.00 MT" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
            </VBox>
        </HBox>

        <!-- TABELAS DE VENDAS E ITENS -->
        <HBox VBox.vgrow="ALWAYS" spacing="15">
            <!-- Tabela de Vendas -->
            <VBox HBox.hgrow="ALWAYS" spacing="8" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <Label text="Historico de Vendas do Periodo" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <TableView fx:id="tabelaVendas" VBox.vgrow="ALWAYS" onMouseClicked="#selecionarVenda">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colData" text="Data/Hora" prefWidth="150"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="180"/>
                        <TableColumn fx:id="colPagamento" text="Forma Pag." prefWidth="120"/>
                        <TableColumn fx:id="colTotalLiquido" text="Total Liquido (MT)" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Tabela de Itens da Venda Selecionada -->
            <VBox prefWidth="380" spacing="8" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <Label fx:id="lblItensVendaTitulo" text="Itens da Venda (Selecione na tabela)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <TableView fx:id="tabelaItensVenda" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colItemProduto" text="Produto" prefWidth="180"/>
                        <TableColumn fx:id="colItemQtd" text="Qtd" prefWidth="50"/>
                        <TableColumn fx:id="colItemPreco" text="P. Unit" prefWidth="70"/>
                        <TableColumn fx:id="colItemSubtotal" text="Subtotal" prefWidth="70"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</VBox>